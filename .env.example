# Variables de Entorno para miniPOS Landing & SaaS
# NUNCA subir el .env real a repositorios públicos

ADMIN_USERNAME=tu_usuario_admin
ADMIN_PASSWORD=tu_clave_admin_segura

ADMIN2_USERNAME=segundo_admin
ADMIN2_PASSWORD=clave_segundo_admin

ADMIN3_USERNAME=tercer_admin
ADMIN3_PASSWORD=clave_tercer_admin

SECRET_KEY=tu_clave_secreta_jwt_aqui_cambiar_en_produccion

# Conexión a Base de Datos (MySQL local o Supabase PostgreSQL en la nube)
# Ejemplo MySQL: mysql+pymysql://user:password@localhost:3306/landing_minipos
# Ejemplo Supabase: postgresql+psycopg2://postgres:TU_CLAVE@db.tu-proyecto.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=mysql+pymysql://minipos_app:TU_CLAVE_SEGURA@localhost:3306/landing_minipos

# Integración: API Externa de Aprovisionamiento de Tenants (miniPOS)
PROVISIONING_API_URL=https://mini-pos-api.vercel.app/api/provisioning/tenant
PROVISIONING_API_USER=tu_usuario_api
PROVISIONING_API_PASSWORD=tu_clave_secreta_api
PROVISIONING_ALLOWED_ORIGINS=*

# Configuración de Despliegue en Render y Dominios
PORT=8000
APP_BASE_URL=https://landing-znexicapos.onrender.com
CORS_ORIGINS=*
